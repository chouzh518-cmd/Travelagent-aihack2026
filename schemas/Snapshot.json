{
  "$defs": {
    "Chunk": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "snapshot_id": {
          "title": "Snapshot Id",
          "type": "string"
        },
        "sequence": {
          "title": "Sequence",
          "type": "integer"
        },
        "chunk_type": {
          "enum": [
            "article",
            "table",
            "appendix",
            "context"
          ],
          "title": "Chunk Type",
          "type": "string"
        },
        "heading_path": {
          "items": {
            "type": "string"
          },
          "title": "Heading Path",
          "type": "array"
        },
        "article_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Article Label"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "locations": {
          "items": {
            "$ref": "#/$defs/Location"
          },
          "title": "Locations",
          "type": "array"
        },
        "tables": {
          "items": {
            "$ref": "#/$defs/Table"
          },
          "title": "Tables",
          "type": "array"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "title": "References",
          "type": "array"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "chunk_id",
        "snapshot_id",
        "sequence",
        "chunk_type",
        "heading_path",
        "article_label",
        "text",
        "locations",
        "tables",
        "references",
        "issues"
      ],
      "title": "Chunk",
      "type": "object"
    },
    "ExtractionOptions": {
      "additionalProperties": false,
      "properties": {
        "html_selector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Html Selector"
        },
        "start_heading": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Heading"
        },
        "end_heading": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Heading"
        }
      },
      "title": "ExtractionOptions",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "page_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Number"
        },
        "chunk_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Id"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "page_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page Number"
        },
        "block_index": {
          "minimum": 1,
          "title": "Block Index",
          "type": "integer"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        }
      },
      "required": [
        "page_number",
        "block_index",
        "locator"
      ],
      "title": "Location",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "target_chunk_ids": {
          "items": {
            "type": "string"
          },
          "title": "Target Chunk Ids",
          "type": "array"
        },
        "status": {
          "enum": [
            "resolved",
            "unresolved",
            "ambiguous"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "label",
        "target_chunk_ids",
        "status"
      ],
      "title": "Reference",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "pdf",
            "docx",
            "html",
            "png",
            "jpg",
            "jpeg",
            "tif",
            "tiff",
            "bmp",
            "webp"
          ],
          "title": "Type",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        },
        "file_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "File Path"
        }
      },
      "required": [
        "type",
        "url",
        "file_path"
      ],
      "title": "Source",
      "type": "object"
    },
    "Table": {
      "additionalProperties": false,
      "properties": {
        "rows": {
          "items": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array"
          },
          "title": "Rows",
          "type": "array"
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "cell_bboxes": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "anyOf": [
                    {
                      "items": {
                        "type": "number"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell Bboxes"
        }
      },
      "required": [
        "rows",
        "location"
      ],
      "title": "Table",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "document_kind": {
      "enum": [
        "policy",
        "template"
      ],
      "title": "Document Kind",
      "type": "string"
    },
    "issuer_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Issuer Name"
    },
    "policy_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Policy Version"
    },
    "revision_date": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Revision Date"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "snapshot_path": {
      "title": "Snapshot Path",
      "type": "string"
    },
    "content_sha256": {
      "title": "Content Sha256",
      "type": "string"
    },
    "queried_at": {
      "title": "Queried At",
      "type": "string"
    },
    "extraction_status": {
      "enum": [
        "success",
        "partial",
        "failed"
      ],
      "title": "Extraction Status",
      "type": "string"
    },
    "extraction": {
      "$ref": "#/$defs/ExtractionOptions"
    },
    "parser_version": {
      "title": "Parser Version",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Issues",
      "type": "array"
    },
    "chunks": {
      "items": {
        "$ref": "#/$defs/Chunk"
      },
      "title": "Chunks",
      "type": "array"
    }
  },
  "required": [
    "document_id",
    "snapshot_id",
    "title",
    "document_kind",
    "issuer_name",
    "policy_version",
    "revision_date",
    "source",
    "snapshot_path",
    "content_sha256",
    "queried_at",
    "extraction_status",
    "extraction",
    "parser_version",
    "issues",
    "chunks"
  ],
  "title": "Snapshot",
  "type": "object"
}