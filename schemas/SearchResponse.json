{
  "$defs": {
    "Chunk": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "snapshot_id": {
          "title": "Snapshot Id",
          "type": "string"
        },
        "sequence": {
          "title": "Sequence",
          "type": "integer"
        },
        "chunk_type": {
          "enum": [
            "article",
            "table",
            "appendix",
            "context"
          ],
          "title": "Chunk Type",
          "type": "string"
        },
        "heading_path": {
          "items": {
            "type": "string"
          },
          "title": "Heading Path",
          "type": "array"
        },
        "article_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Article Label"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "locations": {
          "items": {
            "$ref": "#/$defs/Location"
          },
          "title": "Locations",
          "type": "array"
        },
        "tables": {
          "items": {
            "$ref": "#/$defs/Table"
          },
          "title": "Tables",
          "type": "array"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "title": "References",
          "type": "array"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "chunk_id",
        "snapshot_id",
        "sequence",
        "chunk_type",
        "heading_path",
        "article_label",
        "text",
        "locations",
        "tables",
        "references",
        "issues"
      ],
      "title": "Chunk",
      "type": "object"
    },
    "Hit": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "snapshot_id": {
          "title": "Snapshot Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "document_kind": {
          "enum": [
            "policy",
            "template"
          ],
          "title": "Document Kind",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "snapshot_path": {
          "title": "Snapshot Path",
          "type": "string"
        },
        "content_sha256": {
          "title": "Content Sha256",
          "type": "string"
        },
        "distance": {
          "title": "Distance",
          "type": "number"
        },
        "chunk": {
          "$ref": "#/$defs/Chunk"
        },
        "related_chunks": {
          "items": {
            "$ref": "#/$defs/Chunk"
          },
          "title": "Related Chunks",
          "type": "array"
        }
      },
      "required": [
        "document_id",
        "snapshot_id",
        "title",
        "document_kind",
        "source",
        "snapshot_path",
        "content_sha256",
        "distance",
        "chunk",
        "related_chunks"
      ],
      "title": "Hit",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "page_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Number"
        },
        "chunk_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Id"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "page_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page Number"
        },
        "block_index": {
          "minimum": 1,
          "title": "Block Index",
          "type": "integer"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        }
      },
      "required": [
        "page_number",
        "block_index",
        "locator"
      ],
      "title": "Location",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "target_chunk_ids": {
          "items": {
            "type": "string"
          },
          "title": "Target Chunk Ids",
          "type": "array"
        },
        "status": {
          "enum": [
            "resolved",
            "unresolved",
            "ambiguous"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "label",
        "target_chunk_ids",
        "status"
      ],
      "title": "Reference",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "pdf",
            "docx",
            "html",
            "png",
            "jpg",
            "jpeg",
            "tif",
            "tiff",
            "bmp",
            "webp"
          ],
          "title": "Type",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        },
        "file_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "File Path"
        }
      },
      "required": [
        "type",
        "url",
        "file_path"
      ],
      "title": "Source",
      "type": "object"
    },
    "Table": {
      "additionalProperties": false,
      "properties": {
        "rows": {
          "items": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array"
          },
          "title": "Rows",
          "type": "array"
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "cell_bboxes": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "anyOf": [
                    {
                      "items": {
                        "type": "number"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell Bboxes"
        }
      },
      "required": [
        "rows",
        "location"
      ],
      "title": "Table",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "company_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Company Id"
    },
    "document_ids": {
      "items": {
        "type": "string"
      },
      "title": "Document Ids",
      "type": "array"
    },
    "snapshot_ids": {
      "items": {
        "type": "string"
      },
      "title": "Snapshot Ids",
      "type": "array"
    },
    "usage_mode": {
      "enum": [
        "demo",
        "production"
      ],
      "title": "Usage Mode",
      "type": "string"
    },
    "query": {
      "title": "Query",
      "type": "string"
    },
    "queried_at": {
      "title": "Queried At",
      "type": "string"
    },
    "status": {
      "enum": [
        "found",
        "not_found",
        "blocked",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "retrieval_method": {
      "const": "chroma_semantic_fastembed_v1",
      "default": "chroma_semantic_fastembed_v1",
      "title": "Retrieval Method",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/Hit"
      },
      "title": "Results",
      "type": "array"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Issues",
      "type": "array"
    }
  },
  "required": [
    "company_id",
    "document_ids",
    "snapshot_ids",
    "usage_mode",
    "query",
    "queried_at",
    "status",
    "results",
    "issues"
  ],
  "title": "SearchResponse",
  "type": "object"
}